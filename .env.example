DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Use sqlite for local demo if PostgreSQL is not installed/running.
# Use postgres for production or a full PostgreSQL local setup.
DATABASE_ENGINE=sqlite

POSTGRES_DB=pushparecycle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configure the Google provider in Django Admin > Social applications.
# Callback URL: http://127.0.0.1:8000/accounts/google/login/callback/
